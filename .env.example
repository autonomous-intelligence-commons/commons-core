# --- AIC Phase 1 local development configuration ---------------------------
# Copy to .env for local runs. NEVER commit real secrets. Values below are
# disposable development values only.

# Database (local dev uses SQLite; production targets PostgreSQL)
AIC_DATABASE_URL=sqlite+pysqlite:///./data/commons.db
# PostgreSQL example (production):
# AIC_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/commons

# Master encryption keys. Provide "kid:hex" pairs; the active kid signs new
# envelopes. Hex string must be 64 hex chars (32 bytes) = AES-256 key.
# For local dev, leave AIC_MASTER_KEYS unset — an ephemeral in-memory key is
# generated with a loud warning (data is lost on restart).
# Generate a real dev key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# AIC_MASTER_KEYS=k1:<paste 64-hex-chars here>
# AIC_ACTIVE_KEY_ID=k1

# Token issued by provisioning CLI; hashing uses PBKDF2-HMAC-SHA256.
# Provisioned tokens are displayed once and stored only as salted hashes.
# (No configuration needed — leave the rest unset.)

# API
AIC_API_HOST=127.0.0.1
AIC_API_PORT=8010

# Environment: "development" (default) | "test" | "production".
# PRODUCTION is FAIL-CLOSED: the API refuses to start unless AIC_MASTER_KEYS
# is set (valid 64-hex AES-256 keys + a valid AIC_ACTIVE_KEY_ID) AND
# AIC_DATABASE_URL targets PostgreSQL (SQLite is refused). Placeholder-style
# keys are rejected. The worker/CLI also refuse SQLite in production but do
# NOT require keys (least privilege — they never decrypt content).
#AIC_ENV=development

# Quotas / limits (per-agent unless stated)
AIC_RATE_LIMIT_PER_MINUTE=120
AIC_MAX_MESSAGES_PER_MINUTE=60
AIC_MAX_MESSAGE_BYTES=65536
AIC_MAX_MEMORY_ENTRY_BYTES=65536
AIC_MAX_PENDING_TASKS=1000
AIC_MAX_TASK_ATTEMPTS=3
AIC_TASK_TIMEOUT_SECONDS=30
AIC_RETENTION_SECURITY_EVENTS_DAYS=14
